# ==============================================================================
# KONFIGURASI ENVIRONMENT PRODUKSI — SIMULASI CAT PRIMA RIB
# Salin file ini menjadi .env.local (atau masukkan ke Environment Variables Vercel)
# ==============================================================================

# 1. URL & Kunci Publik Supabase (Salin dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Kunci Service Role Server-Side (RAHASIA - Jangan gunakan prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. URL Aplikasi Produksi
NEXT_PUBLIC_APP_URL=https://cat.primarib.id
